# Telegram API Credentials (obtain from my.telegram.org)
TG_API_ID=your_telegram_api_id
TG_API_HASH=your_telegram_api_hash

# Target Telegram Group/Channel Chat ID
TARGET_CHAT_ID=-5511274738

# Bot Throttling & Intent Classifier Threshold
THROTTLE_COOLDOWN_SECONDS=300
